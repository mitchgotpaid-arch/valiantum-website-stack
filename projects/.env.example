NODE_ENV=production
APP_ORIGIN=https://projects.valiantum.com
PROJECTS_EMAIL=your-email@example.com
# Generate locally using: npm run password
PROJECTS_PASSWORD_HASH=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# Enable for database providers that require TLS with a trusted certificate.
MYSQL_SSL=false

# Marketing OS: reuse the existing Supabase project (never a service-role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=https://projects.valiantum.com
# Optional existing Marketing OS integrations; server-only credentials.
OPENAI_API_KEY=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
META_LOGIN_CONFIG_ID=
