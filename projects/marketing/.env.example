# Public Supabase project URL. Safe to expose to browser code.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key. Do not place the service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical application URL used for auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only OpenAI credential. Not required during Milestone 1.
OPENAI_API_KEY=
OPENAI_DRAFT_MODEL=gpt-6-luna
# Higher-reasoning model used only for live-research daily briefings.
OPENAI_BRIEFING_MODEL=gpt-6.1-sol

# Server-only Meta app credentials for Facebook Page and Instagram Professional
# publishing. Never expose the App Secret with a NEXT_PUBLIC_ prefix.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
META_LOGIN_CONFIG_ID=
