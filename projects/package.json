{
  "name": "valiantum-projects",
  "version": "1.0.0",
  "private": true,
  "description": "Private single-owner Valiantum project workspace",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "password": "node password.js",
    "build": "node scripts/build-marketing.cjs",
    "postinstall": "node scripts/build-marketing.cjs",
    "test:marketing": "vitest run --config marketing/vitest.config.ts",
    "typecheck:marketing": "tsc --noEmit --project marketing/tsconfig.json && tsc --noEmit --project marketing/tsconfig.tests.json",
    "test:marketing-db": "node test/marketing-database.cjs",
    "test:marketing-runtime": "node test/marketing-runtime.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "express": "^4.21.2",
    "mysql2": "^3.14.0",
    "next": "16.4.6",
    "openai": "^7.25.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "vitest": "5.1.0"
  }
}
